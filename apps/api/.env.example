# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Postgres (lihat .runtime/data/.env)
DATABASE_URL=postgres://akreditasi:CHANGE_ME@127.0.0.1:5433/akreditasi

# Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Kunci master (32 byte, base64 atau hex 64 karakter). Buat: openssl rand -base64 32
DOCUMENT_MASTER_KEY=
IDENTITY_MASTER_KEY=

# IPFS Kubo
IPFS_API_URL=http://127.0.0.1:5001

# Fabric
FABRIC_NETWORK_FILE=../../.runtime/fabric/network.json
AUDIT_IDENTITY_DIR=../../.runtime/fabric/audit-identity

# Kafka (hanya untuk health check)
KAFKA_BROKERS=127.0.0.1:9092

# Reconciler
RECONCILER_INTERVAL_MS=30000
RECONCILER_PENDING_AFTER_MS=60000

# Seed
SEED_ACCOUNTS_FILE=../../.runtime/seed-accounts.json
MIGRATIONS_DIR=../../db/migrations

# Modul AI pendukung keputusan (RAG atas LED/LKPS). Kosongkan GEMINI_API_KEY untuk menonaktifkan verifikasi jenis dan analisis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Daftar model cadangan (pisah koma), dicoba berurutan bila model utama 503/429. Kosong = tanpa cadangan.
GEMINI_FALLBACK_MODELS=
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_DIM=768
GEMINI_THINKING_LEVEL=MEDIUM
# Embedding untuk retrieval: local (bawaan, transformers.js di CPU, bebas kuota) atau gemini.
# Mengganti penyedia/model mewajibkan indeks ulang dokumen (POST /submissions/:id/reindex).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-base
EMBEDDING_CACHE_DIR=../../.runtime/models
AI_EMBED_BATCH=16
# Hanya untuk EMBEDDING_PROVIDER=gemini
AI_EMBED_RPM=80
AI_MAX_CONTEXT_TOKENS=120000
# Pembatas laju generasi/embedding (permintaan per menit) dan jeda ulang antrean job (ms)
AI_RPM=4
AI_RETRY_DELAYS_MS=10000,30000,60000,120000,240000
AI_JOB_MAX_ATTEMPTS=4
AI_JOBS_ENABLED=true
# Analisis otomatis saat LED+LKPS lengkap (maks. per 24 jam, pelindung kuota tier gratis)
AI_AUTO_ANALYSIS=true
AI_AUTO_MAX_PER_DAY=12

# Salinan log ke berkas (opsional)
# LOG_FILE=../../.runtime/api.log
