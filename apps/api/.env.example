# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Postgres (lihat .runtime/data/.env)
DATABASE_URL=postgres://akreditasi:CHANGE_ME@127.0.0.1:5433/akreditasi

# Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Kunci master (32 byte, base64 atau hex 64 karakter). Buat: openssl rand -base64 32
DOCUMENT_MASTER_KEY=
IDENTITY_MASTER_KEY=

# IPFS Kubo
IPFS_API_URL=http://127.0.0.1:5001

# Fabric
FABRIC_NETWORK_FILE=../../.runtime/fabric/network.json
AUDIT_IDENTITY_DIR=../../.runtime/fabric/audit-identity

# Kafka (hanya untuk health check)
KAFKA_BROKERS=127.0.0.1:9092

# Reconciler
RECONCILER_INTERVAL_MS=30000
RECONCILER_PENDING_AFTER_MS=60000

# Seed
SEED_ACCOUNTS_FILE=../../.runtime/seed-accounts.json
MIGRATIONS_DIR=../../db/migrations
