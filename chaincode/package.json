{
  "name": "@akreditasi/chaincode",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --tsconfig tsconfig.test.json --test test/*.test.ts",
    "start": "fabric-chaincode-node server --chaincode-address=$CHAINCODE_SERVER_ADDRESS --chaincode-id=$CHAINCODE_ID"
  },
  "dependencies": {
    "fabric-contract-api": "^2.5.0",
    "fabric-shim": "^2.5.0"
  },
  "devDependencies": {
    "@akreditasi/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
